{
  "name": "Black Pater · Espace membre",
  "short_name": "Black Pater",
  "description": "Votre espace membre Black Pater : informations, messages, assistant IA et dossier.",
  "id": "/espace-client",
  "start_url": "/espace-client?app=1",
  "scope": "/espace-client",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f3ec",
  "theme_color": "#f7f3ec",
  "lang": "fr",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "shortcuts": [
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Écrire à Black Pater",
      "url": "/espace-client?view=messages&app=1",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Assistant IA",
      "short_name": "Assistant",
      "description": "Poser une question à l’assistant",
      "url": "/espace-client?view=assistant&app=1",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Actualités",
      "short_name": "Actualités",
      "description": "Les nouvelles officielles de votre pays",
      "url": "/espace-client?view=news&app=1",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mon dossier",
      "short_name": "Dossier",
      "description": "Compléter ou mettre à jour votre dossier",
      "url": "/espace-client?view=dossier&app=1",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
